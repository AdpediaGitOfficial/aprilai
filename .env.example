# ─────────────────────────────────────────────────────────────
# April AI — environment configuration
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ─────────────────────────────────────────────────────────────

# Which provider the chat engine defaults to: "anthropic" | "openai"
AI_PROVIDER=anthropic

# Default model id (optional — sensible per-provider default is used if unset)
# e.g. claude-3-7-sonnet-latest  or  gpt-4o
AI_MODEL=

# Provider API keys — set the one(s) matching AI_PROVIDER
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Reserved for later phases (auth, database, storage) ──
# DATABASE_URL=
# NEXT_PUBLIC_APP_URL=http://localhost:3000
