# ─────────────────────────────────────────────────────────────
# April AI — environment configuration
# Copy to `.env.local` and fill in. Never commit `.env.local`.
#
# Everything below is OPTIONAL. With nothing set, the app runs in guest mode
# with in-memory chat. Add a group to switch on that capability.
# ─────────────────────────────────────────────────────────────

# ── AI engine (needed for the chat to actually respond) ──
# Which provider the chat engine defaults to: "anthropic" | "openai"
AI_PROVIDER=anthropic
# Default model id (optional — a sensible per-provider default is used if unset)
# e.g. claude-3-7-sonnet-latest  or  gpt-4o
AI_MODEL=
# Set the key matching AI_PROVIDER
ANTHROPIC_API_KEY=
# OpenAI key: used for the chat if AI_PROVIDER=openai, AND for embeddings (RAG).
# Setting this + DATABASE_URL turns on document analysis.
OPENAI_API_KEY=

# ── Web search (Tavily) — adds a real web-search tool to the chat ──
# When set, the composer's "Web search" toggle lets April search the live web.
TAVILY_API_KEY=

# ── Auth (Clerk) — enables real users + route protection ──
# Presence of the publishable key turns auth ON. Without it, the app is open
# in guest mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: keep the default in-app routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Database (Postgres) — enables conversation persistence ──
# Presence of DATABASE_URL turns persistence ON. Any Postgres works
# (Neon, Supabase, local). Use a pooled connection string in serverless.
# Then run: npm run db:push   (or db:generate + db:migrate)
DATABASE_URL=
